includes:
    - %rootDir%/../../szepeviktor/phpstan-wordpress/extension.neon

parameters:
    bootstrapFiles:
        - tests/phpstan/phpstan-bootstrap.php
    scanFiles:
        - tests/phpstan/phpstan-wp-cli-stubs.php
    level: 3
    paths:
        - includes
        - wpbridge.php
        - uninstall.php
    excludePaths:
        analyseAndScan:
            - vendor (?)
            - tests (?)
            - node_modules (?)
            - backups (?)
            - examples (?)
    # 忽略的错误模式（level 3 暂无需忽略，升级 level 时按需添加）
    ignoreErrors: []
    checkUninitializedProperties: true
    checkMissingCallableSignature: true
